# Backend base URL used by the mobile app.
# For Android emulator use http://10.0.2.2:3000
# For physical devices use your machine LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional mock mode for local UI-only development.
# true = use local mock data instead of API calls
EXPO_PUBLIC_USE_MOCK_API=false
