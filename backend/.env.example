# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:8081

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ALLOW_LEGACY_CLAIMS_HEADERS=false

# Optional SUPER_ROOT bootstrap account (development only)
SUPER_ROOT_EMAIL=superroot@ipiz.local
SUPER_ROOT_PASSWORD=ChangeMe123!

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/ipiz_db
RBAC_ENFORCED=false

# Local persistent datastore path
DATA_STORE_PATH=.data/app-store.json