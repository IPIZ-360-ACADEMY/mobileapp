# Server Configuration
PORT=3000
NODE_ENV=staging

# CORS Configuration
CORS_ORIGIN=https://staging.mobile.ipiz.ao

# Security (set real secrets in staging pipeline)
JWT_SECRET=replace-with-strong-staging-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ALLOW_LEGACY_CLAIMS_HEADERS=false

# SUPER_ROOT bootstrap for staging access control
SUPER_ROOT_EMAIL=superroot@ipiz.ao
SUPER_ROOT_PASSWORD=replace-with-strong-password

# Database
DATABASE_URL=postgresql://username:password@staging-db-host:5432/ipiz_db
RBAC_ENFORCED=true

# Local persistent datastore path (for non-production local staging)
DATA_STORE_PATH=.data/app-store.json